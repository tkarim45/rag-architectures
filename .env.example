# rag-architectures — credentials to run the architectures (real-only; no mock).
# Copy to `.env` and fill in. `.env` is gitignored. The project also loads the global ~/.env.
#
# WHAT NEEDS A KEY:
#   - Every LLM call goes to Claude on AWS Bedrock: answer generation, GraphRAG entity
#     extraction, RAPTOR cluster summaries, corrective relevance grading, adaptive routing,
#     the agentic tool loop, HyDE drafting, multi-query / RAG-fusion query generation, and the
#     LLM-as-judge scorer.
#   - Embeddings (sentence-transformers all-MiniLM-L6-v2) and the cross-encoder reranker run
#     LOCALLY — no key, just a one-time model download.
#   - There is NO mock in the real runtime: AWS Bedrock (default) or the direct Anthropic API
#     (RAGARCH_LLM_BACKEND=anthropic + ANTHROPIC_API_KEY) is required to run anything real.
#     (Offline tests inject fakes — see core/llm/fake.py.)

# ── AWS Bedrock (required) ────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Option A — standard AWS IAM credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=                     # only for temporary STS credentials

# Option B — a named profile from ~/.aws/credentials (leave the keys above blank)
# AWS_PROFILE=default

# Option C — a Bedrock API key (bearer token)
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# ── Model (optional override) ─────────────────────────────────────────────────
# Bedrock inference-profile ID used for every LLM call (default: Claude Haiku 4.5).
# "global." routes for max availability; swap to "us.anthropic.*" if you lack global profiles.
# RAGARCH_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Your AWS principal needs bedrock:InvokeModel for that model in AWS_REGION, and Bedrock model
# access enabled for it in the AWS console.

# ── Framework knobs (optional) ────────────────────────────────────────────────
# LLM backend: "bedrock" (default) or "anthropic" (direct API; needs ANTHROPIC_API_KEY).
# RAGARCH_LLM_BACKEND=bedrock
# ANTHROPIC_API_KEY=

# Vector store backend: faiss (default, exact IndexFlatIP) | numpy (identical results).
# RAGARCH_VECTORSTORE=faiss

# Disk caches (~/.cache/rag-architectures). Embedding cache on by default (deterministic);
# LLM cache off by default so measured runs stay honest — turn on while iterating on offline
# builds (graph extraction, RAPTOR summaries, contextual chunk prefixes).
# RAGARCH_CACHE_DIR=~/.cache/rag-architectures
# RAGARCH_CACHE_EMBEDDINGS=1
# RAGARCH_CACHE_LLM=0

# Provider tuning
# RAGARCH_TEMPERATURE=0.0
# RAGARCH_MAX_TOKENS=512
# RAGARCH_LLM_TIMEOUT=60
# RAGARCH_EMBED_MODEL=all-MiniLM-L6-v2
